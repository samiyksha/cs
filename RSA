if __name__ == "__main__":
    p = int(input('Enter prime p: '))
    q = int(input('Enter prime q: '))

    print("\nChosen primes:")
    print("p =", p)
    print("q =", q)

    n = p * q
    print("\nn = p * q =", n)

    phi = (p - 1) * (q - 1)
    print("Euler's Totient Function [phi(n)] =", phi)

    print("\nChoose an 'e' from the coprimes of phi(n):")
    print(coprimes(phi, phi))  # Both arguments = phi

    e = int(input("Enter your choice for e: "))

    d = modinv(e, phi)
    print("\nPublic Key  (e, n):", (e, n))
    print("Private Key (d, n):", (d, n))

    s = input("\nEnter a message to encrypt: ")
    print("\nPlaintext message:", s)

    encrypted = encrypt_string(s)
    print("Encrypted message:", encrypted)

    decrypted = decrypt_string(encrypted)
    print("Decrypted message:", decrypted)
