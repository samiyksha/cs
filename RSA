def gcd(a, b):  # Calculates GCD of a and b by eucliden algo
    while b != 0:
        c = a % b
        a = b
        b = c
    return a


def modinv(a, m):  # Calculates modular inverse of a mod m for finding priv keyf
    for x in range(1, m):
        if (a * x) % m == 1:
            return x
    return None


def coprimes(a, phi):  # Calculates co-primes of a and ensures modular inverse exists
    l = []
    for x in range(2, a):
        if gcd(a, x) == 1 and modinv(x, phi) is not None:
            l.append(x)
    for x in l[:]:  # Avoid removing while iterating original list
        if x == modinv(x, phi):
            l.remove(x)
    return l


def encrypt_block(m):  # Encrypts a single ASCII character (as int)
    return pow(m, e, n)


def decrypt_block(c):  # Decrypts a single ASCII character (as int)
    return pow(c, d, n)


def encrypt_string(s):  # Encrypts a string
    return ''.join([chr(encrypt_block(ord(x))) for x in s])


def decrypt_string(s):  # Decrypts a string
    return ''.join([chr(decrypt_block(ord(x))) for x in s])


